{
  "version": "7",
  "catalogId": "maestro-canvas/v1",
  "description": "Render interactive UI by calling the canvas_create, canvas_data and canvas_update tools on the maestro MCP server.",
  "protocol": {
    "messages": [
      {
        "type": "canvas_create",
        "note": "Must be called first for a new surfaceId.",
        "jsonSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": ["sessionUpdate", "surfaceId", "catalogId", "title"],
          "properties": {
            "sessionUpdate": { "type": "string", "const": "canvas_create" },
            "surfaceId": { "type": "string" },
            "catalogId": { "type": "string" },
            "title": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      {
        "type": "canvas_update",
        "note": "Components are a flat adjacency list. Each has an 'id' and 'component' type. Children are referenced by ID in a 'children' array. Repeat to add or update components.",
        "jsonSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": ["sessionUpdate", "surfaceId", "components"],
          "properties": {
            "sessionUpdate": { "type": "string", "const": "canvas_update" },
            "surfaceId": { "type": "string" },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "component"],
                "properties": {
                  "id": { "type": "string" },
                  "component": {
                    "type": "string",
                    "enum": [
                      "Column",
                      "Row",
                      "List",
                      "Card",
                      "Tabs",
                      "Modal",
                      "Divider",
                      "Text",
                      "Image",
                      "Icon",
                      "Video",
                      "AudioPlayer",
                      "Markdown",
                      "DataTable",
                      "Chart",
                      "Html",
                      "Button",
                      "TextField",
                      "CheckBox",
                      "ChoicePicker",
                      "Slider",
                      "DateTimeInput"
                    ]
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      {
        "type": "canvas_data",
        "note": "Use to provide data separately from structure. Reference in component props as the path string (e.g. 'rows': '/rows').",
        "jsonSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": ["sessionUpdate", "surfaceId", "path", "value"],
          "properties": {
            "sessionUpdate": { "type": "string", "const": "canvas_data" },
            "surfaceId": { "type": "string" },
            "path": { "type": "string" },
            "value": {}
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "components": {
    "layout": {
      "Column": {
        "props": { "gap": "number (default 3)", "className": "string" },
        "accepts_children": true
      },
      "Row": {
        "props": {
          "gap": "number (default 3)",
          "wrap": "boolean",
          "align": "start|center|end|stretch",
          "equalWidth": "boolean (default true — children share width equally)"
        },
        "accepts_children": true
      },
      "List": {
        "props": { "items": "[{ text?: string, childId?: string }]", "ordered": "boolean" }
      },
      "Card": { "props": { "title": "string", "description": "string" }, "accepts_children": true },
      "Tabs": { "props": { "tabs": "[{ label: string, childId: string }]" } },
      "Modal": {
        "props": { "trigger": "string (button label)", "title": "string" },
        "accepts_children": true
      },
      "Divider": { "props": { "orientation": "horizontal|vertical" } }
    },
    "content": {
      "Text": {
        "props": {
          "text": "string",
          "variant": "heading|subheading|body|caption|code|label",
          "muted": "boolean"
        }
      },
      "Image": {
        "props": {
          "src": "string",
          "alt": "string",
          "width": "string|number",
          "height": "string|number"
        }
      },
      "Icon": {
        "props": {
          "name": "string (Lucide icon name e.g. 'check-circle')",
          "size": "number (default 16)"
        }
      },
      "Video": { "props": { "src": "string", "poster": "string" } },
      "AudioPlayer": { "props": { "src": "string" } },
      "Markdown": { "props": { "text": "string (markdown text)" } },
      "DataTable": {
        "props": {
          "columns": "[{ key: string, label: string, width?: string }]",
          "rows": "string (JSON Pointer path to row data e.g. /rows) or array. Row data is an array of positional cell arrays — [[cell0, cell1, ...], ...] indexed by column order, NOT objects keyed by column key; objects render as empty cells"
        }
      },
      "Chart": {
        "props": {
          "type": "\"line\" | \"bar\" | \"area\" | \"pie\" (default: line)",
          "data": "string (JSON Pointer path to array of data objects e.g. /chartData)",
          "xKey": "string (object key used for x-axis labels or pie slice names, default: x)",
          "series": "[{ key: string, label: string, color?: string }] — each entry becomes one line/bar/area; pie uses series[0].key as the value field",
          "title": "string (optional label rendered above the chart)"
        },
        "note": "Call canvas_data before canvas_update. Cartesian data format: [{ xKeyValue, seriesKey: number, ... }]. Pie format: [{ xKeyValue, valueKey: number }]."
      },
      "Html": {
        "props": {
          "srcdoc": "string (full self-contained HTML/CSS/JS document)",
          "height": "number (px, default 400)",
          "title": "string (accessibility label)"
        },
        "note": "Rendered in a sandboxed iframe (allow-scripts only, no same-origin). Use for custom charts, animations, or layouts the catalog components cannot express. No double-quote or backslash characters in srcdoc."
      }
    },
    "input": {
      "Button": {
        "props": {
          "label": "string",
          "variant": "default|outline|ghost|destructive|secondary",
          "disabled": "boolean"
        },
        "emits": "click"
      },
      "TextField": {
        "props": {
          "label": "string",
          "placeholder": "string",
          "value": "string",
          "disabled": "boolean"
        },
        "emits": "submit on Enter; its text is always carried in `values`"
      },
      "CheckBox": {
        "props": { "label": "string", "checked": "boolean", "disabled": "boolean" },
        "emits": "change"
      },
      "ChoicePicker": {
        "props": {
          "label": "string",
          "options": "[{ value: string, label: string }]",
          "value": "string",
          "placeholder": "string",
          "disabled": "boolean"
        },
        "emits": "change"
      },
      "Slider": {
        "props": {
          "label": "string",
          "min": "number",
          "max": "number",
          "step": "number",
          "value": "number",
          "disabled": "boolean"
        },
        "emits": "change"
      },
      "DateTimeInput": {
        "props": {
          "label": "string",
          "variant": "date|time|datetime-local",
          "value": "string",
          "disabled": "boolean"
        },
        "emits": "submit on Enter; its value is always carried in `values`"
      }
    }
  }
}
