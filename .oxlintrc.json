{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "vitest"],
  "categories": {},
  "rules": {
    "vitest/require-mock-type-parameters": "off",
    "react/immutability": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/utils/helpers", "@/utils/helpers/**"],
            "message": "Use the @/lib/ alias — it points at the same directory."
          },
          {
            "group": ["@/components/ui", "@/components/ui/**"],
            "message": "Use the @/ui/ alias — it points at the same directory."
          },
          {
            "group": ["@/utils/hooks", "@/utils/hooks/**"],
            "message": "Use the @/hooks/ alias — it points at the same directory."
          },
          {
            "group": ["@/**/*.ts", "@/**/*.tsx", "@/*.ts", "@/*.tsx"],
            "message": "Import aliased modules without the file extension."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/**", "src/views/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/lib/tauri-utils",
                "message": "Components never call IPC: go through a hook or function in src/services/."
              },
              {
                "name": "@/types/bindings",
                "importNames": ["commands"],
                "message": "Components never call IPC: go through a hook or function in src/services/."
              }
            ],
            "patterns": [
              {
                "group": ["@/utils/helpers", "@/utils/helpers/**"],
                "message": "Use the @/lib/ alias — it points at the same directory."
              },
              {
                "group": ["@/components/ui", "@/components/ui/**"],
                "message": "Use the @/ui/ alias — it points at the same directory."
              },
              {
                "group": ["@/utils/hooks", "@/utils/hooks/**"],
                "message": "Use the @/hooks/ alias — it points at the same directory."
              },
              {
                "group": ["@/**/*.ts", "@/**/*.tsx", "@/*.ts", "@/*.tsx"],
                "message": "Import aliased modules without the file extension."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/lib/tauri-utils",
                "message": "Components never call IPC: go through a hook or function in src/services/."
              },
              {
                "name": "@/types/bindings",
                "importNames": ["commands"],
                "message": "Components never call IPC: go through a hook or function in src/services/."
              }
            ],
            "patterns": [
              {
                "group": ["@/utils/helpers", "@/utils/helpers/**"],
                "message": "Use the @/lib/ alias: it points at the same directory."
              },
              {
                "group": ["@/components/ui", "@/components/ui/**"],
                "message": "Use the @/ui/ alias: it points at the same directory."
              },
              {
                "group": ["@/utils/hooks", "@/utils/hooks/**"],
                "message": "Use the @/hooks/ alias: it points at the same directory."
              },
              {
                "group": ["@/**/*.ts", "@/**/*.tsx", "@/*.ts", "@/*.tsx"],
                "message": "Import aliased modules without the file extension."
              },
              {
                "group": ["@/views", "@/views/**"],
                "message": "Components never import from views: move what is shared into src/components/, src/services/ or src/utils/."
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [".claude/*", "sidecar/*", ".planning/*", "src/types/bindings.ts"]
}
